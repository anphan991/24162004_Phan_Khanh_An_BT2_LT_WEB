<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         version="6.0"
         metadata-complete="true">
    <display-name>BT2 - Shopping Servlet Service MVC</display-name>

    <listener>
        <listener-class>lt_web.controllers.AppContextListener</listener-class>
    </listener>

    <filter>
        <filter-name>RememberMeFilter</filter-name>
        <filter-class>lt_web.controllers.RememberMeFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RememberMeFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>lt_web.controllers.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthorizationFilter</filter-name>
        <filter-class>lt_web.controllers.AuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthorizationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/manager/*</url-pattern>
        <url-pattern>/home</url-pattern>
        <url-pattern>/video</url-pattern>
        <url-pattern>/video/*</url-pattern>
        <url-pattern>/video-file</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>lt_web.controllers.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/index</url-pattern>
        <url-pattern>/home</url-pattern>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/home</url-pattern>
        <url-pattern>/manager/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>lt_web.controllers.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WaitingController</servlet-name>
        <servlet-class>lt_web.controllers.WaitingController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WaitingController</servlet-name>
        <url-pattern>/waiting</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterController</servlet-name>
        <servlet-class>lt_web.controllers.RegisterController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterController</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VerifyOtpController</servlet-name>
        <servlet-class>lt_web.controllers.VerifyOtpController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VerifyOtpController</servlet-name>
        <url-pattern>/verify-otp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResendOtpController</servlet-name>
        <servlet-class>lt_web.controllers.ResendOtpController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResendOtpController</servlet-name>
        <url-pattern>/resend-otp</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordController</servlet-name>
        <servlet-class>lt_web.controllers.ForgotPasswordController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordController</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordController</servlet-name>
        <servlet-class>lt_web.controllers.ResetPasswordController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordController</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>lt_web.controllers.LogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ErrorServlet</servlet-name>
        <servlet-class>lt_web.controllers.ErrorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ErrorServlet</servlet-name>
        <url-pattern>/error</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DownloadImageController</servlet-name>
        <servlet-class>lt_web.controllers.DownloadImageController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadImageController</servlet-name>
        <url-pattern>/image</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DownloadVideoController</servlet-name>
        <servlet-class>lt_web.controllers.DownloadVideoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadVideoController</servlet-name>
        <url-pattern>/video-file</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VideoController</servlet-name>
        <servlet-class>lt_web.controllers.VideoController</servlet-class>
        <multipart-config>
            <file-size-threshold>2097152</file-size-threshold>
            <max-file-size>104857600</max-file-size>
            <max-request-size>125829120</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>VideoController</servlet-name>
        <url-pattern>/video</url-pattern>
        <url-pattern>/video/detail</url-pattern>
        <url-pattern>/video/add</url-pattern>
        <url-pattern>/video/edit</url-pattern>
        <url-pattern>/video/delete</url-pattern>
        <url-pattern>/admin/video/list</url-pattern>
        <url-pattern>/admin/video/add</url-pattern>
        <url-pattern>/admin/video/edit</url-pattern>
        <url-pattern>/admin/video/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoryListController</servlet-name>
        <servlet-class>lt_web.controllers.admin.CategoryListController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryListController</servlet-name>
        <url-pattern>/admin/category/list</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoryAddController</servlet-name>
        <servlet-class>lt_web.controllers.admin.CategoryAddController</servlet-class>
        <multipart-config>
            <file-size-threshold>1048576</file-size-threshold>
            <max-file-size>5242880</max-file-size>
            <max-request-size>26214400</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryAddController</servlet-name>
        <url-pattern>/admin/category/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoryEditController</servlet-name>
        <servlet-class>lt_web.controllers.admin.CategoryEditController</servlet-class>
        <multipart-config>
            <file-size-threshold>1048576</file-size-threshold>
            <max-file-size>5242880</max-file-size>
            <max-request-size>26214400</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryEditController</servlet-name>
        <url-pattern>/admin/category/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CategoryDeleteController</servlet-name>
        <servlet-class>lt_web.controllers.admin.CategoryDeleteController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryDeleteController</servlet-name>
        <url-pattern>/admin/category/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserAddController</servlet-name>
        <servlet-class>lt_web.controllers.admin.UserAddController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserAddController</servlet-name>
        <url-pattern>/admin/user/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserEditController</servlet-name>
        <servlet-class>lt_web.controllers.admin.UserEditController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserEditController</servlet-name>
        <url-pattern>/admin/user/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserDeleteController</servlet-name>
        <servlet-class>lt_web.controllers.admin.UserDeleteController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserDeleteController</servlet-name>
        <url-pattern>/admin/user/delete</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index</welcome-file>
    </welcome-file-list>

    <session-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
</web-app>
